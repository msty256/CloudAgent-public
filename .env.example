# ---------------------------------------------------------------------------
# Local release / runtime credentials — copy to .env and fill in.
#
# Never commit real token values. `install.sh` / `install.ps1` copy this file to
# `.env` on first run (and never overwrite an existing `.env`).
# ---------------------------------------------------------------------------

# --- Release publishing (gitcode.com / TestPyPI) ---------------------------
# Only needed if you publish releases from this checkout.
GITCODE_TOKEN=
TEST_PYPI_TOKEN=
# PYPI_TOKEN=
GITCODE_OWNER=
GITCODE_REPO=
GITCODE_API_ROOT=https://api.gitcode.com

# --- Model provider API keys ----------------------------------------------
# Set the key for whichever provider you use. The default provider resolves to
# `zai` (GLM); `cloudagent login` writes the key into the config/keychain
# instead if you prefer not to keep it in this file.
# ZAI_API_KEY=
# GLM_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- Optional runtime knobs -----------------------------------------------
# CLOUDAGENT_MODEL=
# CLOUDAGENT_TELEMETRY_ENABLED=0

# --- SQL 诊断：只读数据库连接（P2.2，optional extra "db"） -------------------
# 受控连接：连接目标仅从 CLOUDAGENT_DB_DSN 环境变量读取（工具输入不接受连接串；密码勿提交）。
# 注意：在此文件中配置不会被自动加载到进程环境，请按以下任一方式生效：
#   1) 持久（推荐）：写入 ~/.cloudagent/config.json 的 "env" 块（启动时自动注入）：
#        {"env": {"CLOUDAGENT_DB_DSN": "postgresql://user:password@host:5432/dbname"}}
#   2) 临时：当前 shell 设置环境变量（Windows: $env:CLOUDAGENT_DB_DSN="postgresql://...")
