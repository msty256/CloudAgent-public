# SWE-bench eval — sibling repos cloned next to cloudagent for the eval harness;
# kept untracked because they are separate projects with their own histories.
/SWE-bench-dev/
/cloudagent/

# SWE-bench eval — generated data (predictions, traces, harness logs, charts);
# the scripts under eval/ are tracked, but eval/runs/ contains per-run output
# that can be GBs and is reproducible.
/eval/runs/
/eval/__pycache__/

# Patches directory was removed in the 2026-09 cleanup: the single-layered
# tree ships the already-patched sources under cloudagent_ext/, and neither
# install.sh nor install.ps1 hydrates/patch a separate src/ tree any more.
# (Recover from git history if the upstream quilt series is ever needed.)
patches/.pc/

# Stray *.patch / *.diff artifacts the agent occasionally writes via its
# Write tool during SWE-bench eval (we disable Write/Edit in the wrapper
# now but old artifacts may persist).
/*.patch
/*.diff

