# Unexpanded Windows env-var paths.
# Some tools write to "%SystemDrive%\ProgramData\..." without expanding the
# variable, dumping a literal "%SystemDrive%" folder into the working tree
# (e.g. Windows SysMain cache.db files). Never commit these.
/%SystemDrive%/
/%ProgramData%/
/%LOCALAPPDATA%/
/%APPDATA%/
/%TEMP%/
/%USERPROFILE%/
/%WINDIR%/

# Local agent memory / workspace scratch (not for upstream)
/.workbuddy/

